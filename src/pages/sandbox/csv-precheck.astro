---
import SandboxLayout from "../../shared/SandboxLayout.astro";
import { BATCH_ROWS } from "../../tools/csv-precheck/checks/size";
---

<SandboxLayout title="CSV Pre-check">
  <label class="drop" id="drop">
    <input type="file" id="file" accept=".csv,.tsv,.txt,text/csv" />
    <span>Open a CSV file, or drop it here</span>
  </label>
  <div class="progress" id="progress" role="status" hidden>
    <progress id="progress-bar" max="1" value="0"></progress>
    <span id="progress-text"></span>
  </div>
  <p class="failure" id="failure" role="alert" hidden></p>
  <section id="result" aria-live="polite" hidden>
    <h2 id="file-name"></h2>
    <p id="summary"></p>
    <p id="id-line" hidden></p>
    <div class="date-setting" id="date-setting" hidden>
      <p id="date-line"></p>
      <label>
        <input type="checkbox" id="european" />
        Use European date format (dd/MM/yyyy), as in Data Loader's Settings
      </label>
    </div>
    <div class="key-picker" id="key-picker">
      <label>
        Key column
        <select id="key-column"></select>
      </label>
      <label>
        <input type="checkbox" id="key-loose" />
        Ignore letter case and surrounding spaces
      </label>
    </div>
    <p id="key-line" hidden></p>
    <p id="clean" class="clean" hidden>
      No problems found.
    </p>
    <div id="findings"></div>
    <button type="button" id="download">
      Download report
    </button>
    <section class="tool-section" id="convert">
      <h3>Convert 15-character IDs to 18</h3>
      <p class="tool-help">
        Adds the 3-character suffix to every 15-character ID in the ID columns, so letter case no
        longer matters. Nothing else in the file changes.
      </p>
      <p id="convert-plan"></p>
      <button type="button" id="convert-download">
        Convert 15→18
      </button>
    </section>
    <section class="tool-section" id="split">
      <h3>Split into smaller files</h3>
      <p class="tool-help">
        Each file starts with the header row and holds up to this many data rows, in their original
        order and exactly as written. The files download together as one zip.
      </p>
      <label>
        Rows per file
        <input type="number" id="split-rows" min="1" step="1" value={BATCH_ROWS} />
      </label>
      <p id="split-plan"></p>
      <button type="button" id="split-download">
        Download files as zip
      </button>
    </section>
  </section>
</SandboxLayout>

<script>
  import { MAX_ZIP_FILES } from "../../shared/zip";
  import { convertedName } from "../../tools/csv-precheck/convert";
  import { formatLocation, type FindingGroup } from "../../tools/csv-precheck/findings";
  import {
    dateLine,
    idLine,
    keyLine,
    plural,
    renderText,
    summaryLine,
  } from "../../tools/csv-precheck/report";
  import { baseName, partName } from "../../tools/csv-precheck/split";
  import type { Handlers, Reply, Request } from "../../tools/csv-precheck/worker";
  import CheckWorker from "../../tools/csv-precheck/worker?worker&inline";

  const input = document.querySelector<HTMLInputElement>("#file")!;
  const drop = document.querySelector<HTMLLabelElement>("#drop")!;
  const progress = document.querySelector<HTMLElement>("#progress")!;
  const progressBar = document.querySelector<HTMLProgressElement>("#progress-bar")!;
  const progressText = document.querySelector<HTMLElement>("#progress-text")!;
  const failure = document.querySelector<HTMLElement>("#failure")!;
  const result = document.querySelector<HTMLElement>("#result")!;
  const fileName = document.querySelector<HTMLElement>("#file-name")!;
  const summary = document.querySelector<HTMLElement>("#summary")!;
  const clean = document.querySelector<HTMLElement>("#clean")!;
  const findings = document.querySelector<HTMLElement>("#findings")!;
  const download = document.querySelector<HTMLButtonElement>("#download")!;
  const keyPicker = document.querySelector<HTMLElement>("#key-picker")!;
  const keyColumn = document.querySelector<HTMLSelectElement>("#key-column")!;
  const keyLoose = document.querySelector<HTMLInputElement>("#key-loose")!;
  const keyText = document.querySelector<HTMLElement>("#key-line")!;
  const idText = document.querySelector<HTMLElement>("#id-line")!;
  const dateSetting = document.querySelector<HTMLElement>("#date-setting")!;
  const dateText = document.querySelector<HTMLElement>("#date-line")!;
  const european = document.querySelector<HTMLInputElement>("#european")!;
  const convert = document.querySelector<HTMLElement>("#convert")!;
  const convertPlan = document.querySelector<HTMLElement>("#convert-plan")!;
  const convertDownload = document.querySelector<HTMLButtonElement>("#convert-download")!;
  const split = document.querySelector<HTMLElement>("#split")!;
  const splitRows = document.querySelector<HTMLInputElement>("#split-rows")!;
  const splitPlan = document.querySelector<HTMLElement>("#split-plan")!;
  const splitDownload = document.querySelector<HTMLButtonElement>("#split-download")!;
  let reportText = "";

  // ── Worker
  // The file is parsed and checked in a worker, so the page stays responsive and can show
  // progress. Vite starts it from a blob: URL, which the CSP allows; its data: URL fallback
  // stays blocked, and a worker that cannot start ends up in fail().
  const worker = new CheckWorker();
  let nextId = 0;
  // Set once the worker has failed to start or has crashed; every later call fails with it.
  let stopped: Error | undefined;
  const pending = new Map<
    number,
    { resolve(v: unknown): void; reject(e: Error): void; onProgress?(f: number): void }
  >();

  function call<K extends keyof Handlers>(
    type: K,
    args: Parameters<Handlers[K]>[0],
    { transfer = [], onProgress }: { transfer?: Transferable[]; onProgress?(f: number): void } = {},
  ): Promise<ReturnType<Handlers[K]>> {
    if (stopped) return Promise.reject(stopped);
    const id = nextId++;
    return new Promise((resolve, reject) => {
      pending.set(id, { resolve: resolve as (v: unknown) => void, reject, onProgress });
      worker.postMessage({ id, type, args } as Request, transfer);
    });
  }

  worker.addEventListener("message", ({ data }: MessageEvent<Reply>) => {
    const request = pending.get(data.id);
    if (!request) return;
    if ("progress" in data) return request.onProgress?.(data.progress);
    pending.delete(data.id);
    if ("error" in data) request.reject(new Error(data.error));
    else request.resolve(data.result);
  });

  function fail(message: string) {
    progress.hidden = true;
    result.hidden = true;
    failure.textContent = message;
    failure.hidden = false;
  }

  worker.addEventListener("error", (e) => {
    e.preventDefault();
    stopped = new Error("This browser could not run the checker, so the file was not checked.");
    for (const request of pending.values()) request.reject(stopped);
    pending.clear();
    if (latest) fail(stopped.message);
  });

  // ── Report
  const SEVERITY_LABELS = { error: "Error", warning: "Warning", info: "Info" };
  // Locations shown per "Show more", after the first few.
  const MORE_PAGE = 50;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = "") {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    return node;
  }

  function exampleItem(example: FindingGroup["examples"][number]): HTMLElement | undefined {
    if (!example.location && !example.detail) return undefined;
    const item = el("li", "example");
    if (example.location) item.append(el("strong", "where", formatLocation(example.location)));
    if (example.location && example.detail) item.append(": ");
    if (example.detail) item.append(el("code", "detail", example.detail));
    return item;
  }

  // Built with textContent only: file contents end up in titles and details. A large group
  // lists its first locations and fetches the rest from the worker a page at a time.
  function renderGroup(group: FindingGroup, reportId: number): HTMLElement {
    const section = el("section", `finding ${group.severity}`);
    section.dataset.kind = group.kind;
    const heading = el("h3", "finding-title");
    heading.append(
      el("span", "severity", SEVERITY_LABELS[group.severity]),
      ` ${group.title} `,
      el("span", "count", `(${group.count.toLocaleString("en-US")})`),
    );
    section.append(heading, el("p", "explanation", group.explanation));
    const list = el("ul", "examples");
    const add = (examples: FindingGroup["examples"]) => {
      for (const example of examples) {
        const item = exampleItem(example);
        if (item) list.append(item);
      }
    };
    add(group.examples);
    section.append(list);
    list.hidden = list.childElementCount === 0;

    let shown = group.examples.length;
    const more = el("p", "more");
    const left = el("span", "more-count");
    const button = el("button", "show-more");
    button.type = "button";
    const update = () => {
      const rest = group.count - shown;
      more.hidden = rest <= 0;
      left.textContent = `and ${rest.toLocaleString("en-US")} more`;
      button.textContent = `Show ${Math.min(rest, MORE_PAGE).toLocaleString("en-US")} more`;
    };
    more.append(left, " ", button);
    button.addEventListener("click", () =>
      run(async () => {
        button.disabled = true;
        const examples = await call("more", { kind: group.kind, from: shown, count: MORE_PAGE });
        if (reportId !== latestReport) return;
        add(examples);
        list.hidden = list.childElementCount === 0;
        shown += examples.length;
        button.disabled = false;
        update();
      }),
    );
    update();
    section.append(more);
    return section;
  }

  let latest: File | undefined;
  let latestReport = -1;
  let rowCount = 0;

  // The rows per file the user entered, or undefined when it is not a usable number.
  function rowsPerFile(): number | undefined {
    const n = Number(splitRows.value);
    return splitRows.value !== "" && Number.isInteger(n) && n >= 1 ? n : undefined;
  }

  function showSplit() {
    split.hidden = rowCount === 0;
    if (!latest || rowCount === 0) return;
    const n = rowsPerFile();
    const parts = n === undefined ? 0 : Math.ceil(rowCount / n);
    if (n === undefined) {
      splitPlan.textContent = "Enter a whole number of at least 1.";
    } else if (parts > MAX_ZIP_FILES) {
      splitPlan.textContent = `That makes ${plural(parts, "file")}, more than a zip can hold. Enter a larger number.`;
    } else {
      const first = partName(latest.name, 0, parts);
      const last = partName(latest.name, parts - 1, parts);
      splitPlan.textContent =
        parts === 1
          ? `1 file, ${first}, with all ${plural(rowCount, "row")}.`
          : `${plural(parts, "file")}, ${first} to ${last}.`;
    }
    splitDownload.disabled = n === undefined || parts > MAX_ZIP_FILES;
  }

  // The conversion is offered only when it would change something.
  function showConvert(count: number) {
    convert.hidden = count === 0;
    convertPlan.textContent = `${plural(count, "ID")} of 15 characters to convert.`;
  }

  // Header names go in via textContent, like the findings.
  function fillKeyColumns(header: string[] | null) {
    const none = el("option", "", "None");
    none.value = "";
    const options = (header ?? []).map((name, i) => {
      const option = el("option", "", name.trim() === "" ? `Column ${i + 1}` : name);
      option.value = String(i);
      return option;
    });
    keyColumn.replaceChildren(none, ...options);
    keyPicker.hidden = options.length === 0;
  }

  // Runs on opening a file and on every key or date setting change; the worker parsed the
  // file and ran the other checks once, on opening it.
  async function show() {
    const file = latest;
    if (!file) return;
    const key =
      keyColumn.value === ""
        ? undefined
        : { column: Number(keyColumn.value), ignoreCaseAndSpaces: keyLoose.checked };
    const reportId = ++latestReport;
    const report = await call("report", { key, european: european.checked });
    // A newer file or setting wins, whichever reply comes first.
    if (file !== latest || reportId !== latestReport) return;
    reportText = renderText(file.name, report);
    rowCount = report.rowCount;
    fileName.textContent = file.name;
    summary.textContent = summaryLine(report);
    keyText.textContent = keyLine(report);
    keyText.hidden = !report.key;
    idText.textContent = idLine(report);
    idText.hidden = report.idColumns.length === 0;
    dateText.textContent = dateLine(report);
    dateSetting.hidden = report.dateColumns.length === 0;
    clean.hidden = report.groups.length > 0;
    findings.replaceChildren(...report.groups.map((g) => renderGroup(g, reportId)));
    showSplit();
    progress.hidden = true;
    result.hidden = false;
  }

  function showProgress(file: File, fraction: number) {
    if (file !== latest) return;
    progressBar.value = fraction;
    progressText.textContent =
      fraction < 1
        ? `Reading ${file.name}: ${Math.floor(fraction * 100)}%`
        : `Checking ${file.name}`;
  }

  async function open(file: File) {
    latest = file;
    result.hidden = true;
    failure.hidden = true;
    progress.hidden = false;
    showProgress(file, 0);
    const contents = await file.arrayBuffer();
    // A file opened while an earlier one was still reading wins, whichever finishes first.
    if (file !== latest) return;
    const { header, convertible } = await call("open", contents, {
      transfer: [contents],
      onProgress: (fraction) => showProgress(file, fraction),
    });
    if (file !== latest) return;
    fillKeyColumns(header);
    showConvert(convertible);
    await show();
  }

  // Errors from the worker end up on the page rather than in the console only.
  function run(task: () => Promise<void>) {
    task().catch((e: unknown) => {
      const message = e instanceof Error ? e.message : String(e);
      fail(e === stopped ? message : `The file could not be checked: ${message}`);
    });
  }

  keyColumn.addEventListener("change", () => run(show));
  keyLoose.addEventListener("change", () => run(show));
  european.addEventListener("change", () => run(show));
  splitRows.addEventListener("input", showSplit);

  input.addEventListener("change", () => {
    const file = input.files?.[0];
    if (file) run(() => open(file));
  });
  drop.addEventListener("dragover", (e) => e.preventDefault());
  drop.addEventListener("drop", (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files[0];
    if (file) run(() => open(file));
  });
  function save(blob: Blob, name: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    a.click();
    URL.revokeObjectURL(url);
  }

  download.addEventListener("click", () => {
    save(new Blob([reportText], { type: "text/plain" }), "csv-precheck-report.txt");
  });
  convertDownload.addEventListener("click", () =>
    run(async () => {
      const file = latest;
      if (!file) return;
      const converted = await call("convert", undefined);
      if (file !== latest) return;
      save(new Blob([converted], { type: "text/csv" }), convertedName(file.name));
    }),
  );
  splitDownload.addEventListener("click", () =>
    run(async () => {
      const file = latest;
      const n = rowsPerFile();
      if (!file || n === undefined) return;
      const zip = await call("split", { name: file.name, rowsPerFile: n });
      if (file !== latest) return;
      save(new Blob([zip], { type: "application/zip" }), `${baseName(file.name)}-parts.zip`);
    }),
  );
</script>

<style>
  .drop {
    display: block;
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 2rem 1rem;
    margin: 1rem;
    text-align: center;
    cursor: pointer;
  }
  .drop input {
    display: block;
    max-width: 100%;
    margin: 0 auto 0.5rem;
  }
  #result {
    margin: 1rem;
    overflow-wrap: anywhere;
  }
  #result h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  #summary {
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .key-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
  }
  .key-picker[hidden] {
    display: none;
  }
  .key-picker label {
    min-width: 0;
    max-width: 100%;
  }
  .key-picker select {
    max-width: 100%;
  }
  .date-setting {
    margin: 0 0 1rem;
  }
  .date-setting[hidden] {
    display: none;
  }
  #date-line {
    margin: 0 0 0.25rem;
  }
  #key-line,
  #id-line {
    margin: 0 0 1rem;
  }
  .clean {
    border-left: 4px solid #1a7f37;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
  }
  .finding {
    border-left: 4px solid var(--border);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1rem;
  }
  .finding.error {
    border-color: #cf222e;
  }
  .finding.warning {
    border-color: #bf8700;
  }
  .finding.info {
    border-color: var(--accent);
  }
  .finding-title {
    font-size: 1rem;
    margin: 0.25rem 0;
  }
  .severity {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0 0.3rem;
    vertical-align: middle;
  }
  .error .severity {
    color: #cf222e;
  }
  .warning .severity {
    color: #9a6700;
  }
  .info .severity {
    color: var(--accent);
  }
  .progress {
    margin: 1rem;
  }
  .progress[hidden] {
    display: none;
  }
  .progress progress {
    display: block;
    width: 100%;
    margin: 0 0 0.25rem;
  }
  .failure {
    border-left: 4px solid #cf222e;
    padding: 0.5rem 0.75rem;
    margin: 1rem;
  }
  .count,
  .more {
    color: var(--muted);
  }
  .explanation {
    margin: 0.25rem 0;
  }
  .examples {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }
  .detail {
    font-size: 0.85em;
  }
  .more {
    margin: 0.25rem 0;
  }
  .more[hidden] {
    display: none;
  }
  .show-more {
    margin-left: 0.25rem;
  }
  #download {
    display: block;
  }
  .tool-section {
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
  }
  .tool-section[hidden] {
    display: none;
  }
  .tool-section h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }
  .tool-help {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  #split-rows {
    width: 8rem;
    max-width: 100%;
  }
  #convert-plan,
  #split-plan {
    margin: 0.5rem 0;
  }
</style>
