---
import SandboxLayout from "../../shared/SandboxLayout.astro";
import { BATCH_ROWS } from "../../tools/csv-precheck/checks/size";
---

<SandboxLayout title="CSV Pre-check">
  <label class="drop" id="drop">
    <input type="file" id="file" accept=".csv,.tsv,.txt,text/csv" />
    <span>Open a CSV file, or drop it here</span>
  </label>
  <section id="result" aria-live="polite" hidden>
    <h2 id="file-name"></h2>
    <p id="summary"></p>
    <div class="key-picker" id="key-picker">
      <label>
        Key column
        <select id="key-column"></select>
      </label>
      <label>
        <input type="checkbox" id="key-loose" />
        Ignore letter case and surrounding spaces
      </label>
    </div>
    <p id="key-line" hidden></p>
    <p id="clean" class="clean" hidden>
      No problems found.
    </p>
    <div id="findings"></div>
    <button type="button" id="download">
      Download report
    </button>
    <section class="split" id="split">
      <h3>Split into smaller files</h3>
      <p class="split-help">
        Each file starts with the header row and holds up to this many data rows, in their original
        order and exactly as written. The files download together as one zip.
      </p>
      <label>
        Rows per file
        <input type="number" id="split-rows" min="1" step="1" value={BATCH_ROWS} />
      </label>
      <p id="split-plan"></p>
      <button type="button" id="split-download">
        Download files as zip
      </button>
    </section>
  </section>
</SandboxLayout>

<script>
  import { createZip, MAX_ZIP_FILES } from "../../shared/zip";
  import { CHECKS } from "../../tools/csv-precheck/checks";
  import { formatLocation, type FindingGroup } from "../../tools/csv-precheck/findings";
  import {
    buildReport,
    keyLine,
    plural,
    prepareCsv,
    renderText,
    summaryLine,
    type PreparedCsv,
  } from "../../tools/csv-precheck/report";
  import { baseName, partName, splitCsv } from "../../tools/csv-precheck/split";

  const input = document.querySelector<HTMLInputElement>("#file")!;
  const drop = document.querySelector<HTMLLabelElement>("#drop")!;
  const result = document.querySelector<HTMLElement>("#result")!;
  const fileName = document.querySelector<HTMLElement>("#file-name")!;
  const summary = document.querySelector<HTMLElement>("#summary")!;
  const clean = document.querySelector<HTMLElement>("#clean")!;
  const findings = document.querySelector<HTMLElement>("#findings")!;
  const download = document.querySelector<HTMLButtonElement>("#download")!;
  const keyPicker = document.querySelector<HTMLElement>("#key-picker")!;
  const keyColumn = document.querySelector<HTMLSelectElement>("#key-column")!;
  const keyLoose = document.querySelector<HTMLInputElement>("#key-loose")!;
  const keyText = document.querySelector<HTMLElement>("#key-line")!;
  const split = document.querySelector<HTMLElement>("#split")!;
  const splitRows = document.querySelector<HTMLInputElement>("#split-rows")!;
  const splitPlan = document.querySelector<HTMLElement>("#split-plan")!;
  const splitDownload = document.querySelector<HTMLButtonElement>("#split-download")!;
  let reportText = "";

  const SEVERITY_LABELS = { error: "Error", warning: "Warning", info: "Info" };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = "") {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = text;
    return node;
  }

  // Built with textContent only: file contents end up in titles and details.
  function renderGroup(group: FindingGroup): HTMLElement {
    const section = el("section", `finding ${group.severity}`);
    section.dataset.kind = group.kind;
    const heading = el("h3", "finding-title");
    heading.append(
      el("span", "severity", SEVERITY_LABELS[group.severity]),
      ` ${group.title} `,
      el("span", "count", `(${group.count.toLocaleString("en-US")})`),
    );
    section.append(heading, el("p", "explanation", group.explanation));
    const list = el("ul", "examples");
    for (const example of group.examples) {
      if (!example.location && !example.detail) continue;
      const item = el("li", "example");
      if (example.location) item.append(el("strong", "where", formatLocation(example.location)));
      if (example.location && example.detail) item.append(": ");
      if (example.detail) item.append(el("code", "detail", example.detail));
      list.append(item);
    }
    if (list.childElementCount > 0) section.append(list);
    const more = group.count - group.examples.length;
    if (more > 0) section.append(el("p", "more", `and ${more.toLocaleString("en-US")} more`));
    return section;
  }

  let latest: File | undefined;
  let prepared: PreparedCsv | undefined;
  // The file's own bytes, which the split copies so its encoding and line endings survive.
  let bytes: Uint8Array | undefined;

  // The rows per file the user entered, or undefined when it is not a usable number.
  function rowsPerFile(): number | undefined {
    const n = Number(splitRows.value);
    return splitRows.value !== "" && Number.isInteger(n) && n >= 1 ? n : undefined;
  }

  function showSplit() {
    const rowCount = prepared?.csv.rows.length ?? 0;
    split.hidden = rowCount === 0;
    if (!latest || rowCount === 0) return;
    const n = rowsPerFile();
    const parts = n === undefined ? 0 : Math.ceil(rowCount / n);
    if (n === undefined) {
      splitPlan.textContent = "Enter a whole number of at least 1.";
    } else if (parts > MAX_ZIP_FILES) {
      splitPlan.textContent = `That makes ${plural(parts, "file")}, more than a zip can hold. Enter a larger number.`;
    } else {
      const first = partName(latest.name, 0, parts);
      const last = partName(latest.name, parts - 1, parts);
      splitPlan.textContent =
        parts === 1
          ? `1 file, ${first}, with all ${plural(rowCount, "row")}.`
          : `${plural(parts, "file")}, ${first} to ${last}.`;
    }
    splitDownload.disabled = n === undefined || parts > MAX_ZIP_FILES;
  }

  // Header names go in via textContent, like the findings.
  function fillKeyColumns(header: string[] | null) {
    const none = el("option", "", "None");
    none.value = "";
    const options = (header ?? []).map((name, i) => {
      const option = el("option", "", name.trim() === "" ? `Column ${i + 1}` : name);
      option.value = String(i);
      return option;
    });
    keyColumn.replaceChildren(none, ...options);
    keyPicker.hidden = options.length === 0;
  }

  // Runs on opening a file and on every key change; the file is parsed and the other
  // checks run only once, in prepareCsv.
  function show() {
    if (!latest || !prepared) return;
    const key =
      keyColumn.value === ""
        ? undefined
        : { column: Number(keyColumn.value), ignoreCaseAndSpaces: keyLoose.checked };
    const report = buildReport(prepared, key);
    reportText = renderText(latest.name, report);
    fileName.textContent = latest.name;
    summary.textContent = summaryLine(report);
    keyText.textContent = keyLine(report);
    keyText.hidden = !report.key;
    clean.hidden = report.groups.length > 0;
    findings.replaceChildren(...report.groups.map(renderGroup));
    showSplit();
    result.hidden = false;
  }

  async function open(file: File) {
    latest = file;
    const contents = new Uint8Array(await file.arrayBuffer());
    // A file opened while an earlier one was still reading wins, whichever finishes first.
    if (file !== latest) return;
    bytes = contents;
    // Decoded as file.text() would, dropping a UTF-8 byte order mark.
    prepared = prepareCsv(new TextDecoder().decode(contents), CHECKS, contents.byteLength);
    fillKeyColumns(prepared.csv.header);
    show();
  }

  keyColumn.addEventListener("change", show);
  keyLoose.addEventListener("change", show);
  splitRows.addEventListener("input", showSplit);

  input.addEventListener("change", () => {
    if (input.files?.[0]) void open(input.files[0]);
  });
  drop.addEventListener("dragover", (e) => e.preventDefault());
  drop.addEventListener("drop", (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files[0];
    if (file) void open(file);
  });
  function save(blob: Blob, name: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = name;
    a.click();
    URL.revokeObjectURL(url);
  }

  download.addEventListener("click", () => {
    save(new Blob([reportText], { type: "text/plain" }), "csv-precheck-report.txt");
  });
  splitDownload.addEventListener("click", () => {
    const n = rowsPerFile();
    if (!latest || !prepared || !bytes || n === undefined) return;
    const name = latest.name;
    const parts = splitCsv(bytes, prepared.csv.delimiter, n);
    const zip = createZip(
      parts.map((data, i) => ({ name: partName(name, i, parts.length), data })),
    );
    save(new Blob([zip], { type: "application/zip" }), `${baseName(name)}-parts.zip`);
  });
</script>

<style>
  .drop {
    display: block;
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 2rem 1rem;
    margin: 1rem;
    text-align: center;
    cursor: pointer;
  }
  .drop input {
    display: block;
    max-width: 100%;
    margin: 0 auto 0.5rem;
  }
  #result {
    margin: 1rem;
    overflow-wrap: anywhere;
  }
  #result h2 {
    font-size: 1.1rem;
    margin: 0;
  }
  #summary {
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .key-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1rem;
  }
  .key-picker[hidden] {
    display: none;
  }
  .key-picker label {
    min-width: 0;
    max-width: 100%;
  }
  .key-picker select {
    max-width: 100%;
  }
  #key-line {
    margin: 0 0 1rem;
  }
  .clean {
    border-left: 4px solid #1a7f37;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
  }
  .finding {
    border-left: 4px solid var(--border);
    padding: 0.25rem 0.75rem;
    margin: 0 0 1rem;
  }
  .finding.error {
    border-color: #cf222e;
  }
  .finding.warning {
    border-color: #bf8700;
  }
  .finding.info {
    border-color: var(--accent);
  }
  .finding-title {
    font-size: 1rem;
    margin: 0.25rem 0;
  }
  .severity {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0 0.3rem;
    vertical-align: middle;
  }
  .error .severity {
    color: #cf222e;
  }
  .warning .severity {
    color: #9a6700;
  }
  .info .severity {
    color: var(--accent);
  }
  .count,
  .more {
    color: var(--muted);
  }
  .explanation {
    margin: 0.25rem 0;
  }
  .examples {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }
  .detail {
    font-size: 0.85em;
  }
  .more {
    margin: 0.25rem 0;
  }
  #download {
    display: block;
  }
  .split {
    border-top: 1px solid var(--border);
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
  }
  .split[hidden] {
    display: none;
  }
  .split h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }
  .split-help {
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  #split-rows {
    width: 8rem;
    max-width: 100%;
  }
  #split-plan {
    margin: 0.5rem 0;
  }
</style>
