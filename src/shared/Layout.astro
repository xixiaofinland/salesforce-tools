---
import Analytics from "./Analytics.astro";
import "./global.css";
import { jsonLdScript } from "./seo";

interface Props {
  title: string;
  description: string;
  // schema.org structured data, e.g. a tool's SoftwareApplication.
  jsonLd?: object;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Salesforce Tools" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    <Analytics />
  </head>
  <body>
    <header>
      <a href="/">Salesforce Tools</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        Free, open source:
        <a href="https://github.com/xixiaofinland/salesforce-tools">source on GitHub</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  header,
  main,
  footer {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1rem;
  }
  header a {
    font-weight: 600;
    text-decoration: none;
  }
  footer {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
